# Model backend: responses | openai_compatible
LANUS_PLANNER_BACKEND=responses

# Direct vision model settings. If omitted locally, Lanus reads only the
# provider endpoint/model/credential from the local provider config.
LANUS_LLM_BASE_URL=https://api.deepseek.com
LANUS_LLM_MODEL=deepseek-v4-flash-vision-exp
LANUS_LLM_API_KEY=
LANUS_LLM_TIMEOUT=120

# Optional provider-config path used only as an endpoint/credential fallback.
# LANUS_PROVIDER_CONFIG=/Users/jiangxufeng1/.codex/config.toml

# Browser and execution settings.
LANUS_HEADLESS=true
LANUS_MAX_CONCURRENCY=3
LANUS_COMMAND_TIMEOUT=90
LANUS_OBSERVE_TIMEOUT=30
LANUS_MAX_STEP_ATTEMPTS=3
LANUS_MAX_PLANNER_REPAIRS=2
LANUS_MAX_ACTION_ROUNDS=8
LANUS_RECURSION_LIMIT=500

# Runtime output. Defaults to ~/Desktop/Lisa输出/Lanus-Ui-test.
# LANUS_ARTIFACTS_DIR=/absolute/path

# Tool locations. Auto-detection works on this Mac by default.
# LANUS_NODE_BIN=/Users/jiangxufeng1/.local/node-v22.23.2-darwin-x64/bin/node
# LANUS_PLAYWRIGHT_BIN=/usr/local/bin/playwright-cli
# LANUS_PLAYWRIGHT_JS=/usr/local/lib/node_modules/@playwright/cli/playwright-cli.js
